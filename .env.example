# 本番用の環境変数（本番マシンの voiloid/.env に置く。Git には登録しない）
# 値の生成例: openssl rand -base64 32

# ---------- 公開 URL ----------
# Web GUI のドメイン（Caddy が HTTPS 証明書を自動取得する）
APP_DOMAIN=console.example.com
ACME_EMAIL=admin@example.com

# ---------- Discord（Developer Portal） ----------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_TOKEN=
# 同じサーバーの複数 VC で同時に読み上げる場合のサブボット（カンマ区切り・任意）
SUB_BOT_TOKENS=
# OAuth2 の Redirect に https://<APP_DOMAIN>/api/auth/callback を登録すること

# ---------- 運営者 ----------
# 運営コンソール（/admin）を使える Discord ユーザー ID（カンマ区切り）。
# Discord の「開発者モード」を有効にし、自分のアイコンを右クリック →「ユーザー ID をコピー」で確認できる
OPERATOR_DISCORD_USER_IDS=

# ---------- 秘匿値（ランダムに生成する） ----------
# 32 バイトの base64（openssl rand -base64 32）
SESSION_ENCRYPTION_KEY=
IP_HASH_SALT=
# Bot / Control API → Worker Gateway の内部 API（32 文字以上）
INTERNAL_API_TOKEN=

# ---------- PostgreSQL ----------
POSTGRES_USER=voiloid
POSTGRES_PASSWORD=
POSTGRES_DB=voiloid
DATABASE_URL=postgresql://voiloid:<POSTGRES_PASSWORD>@postgres:5432/voiloid
# Connection Pooler を使う場合は DATABASE_URL を Pooler、こちらを直接接続にする
DIRECT_DATABASE_URL=

# ---------- S3 互換ストレージ（Bot アバターの原本保存） ----------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---------- Worker ----------
# 利用者に案内する Worker イメージ（GitHub Actions が GHCR に公開する）
WORKER_IMAGE=ghcr.io/<owner>/voiloid-worker:latest
# 同じマシンで公式Worker を動かす場合（docker compose --profile official-worker）
OFFICIAL_WORKER_TOKEN=

# ---------- 運用 ----------
LOG_LEVEL=info
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
