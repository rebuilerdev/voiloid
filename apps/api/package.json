{
  "name": "@voiloid/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "node ../../scripts/build-app.mjs src/main.ts src/admin.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "admin": "tsx --env-file-if-exists=.env src/admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "@fastify/cookie": "11.1.3",
    "@voiloid/database": "*",
    "@voiloid/shared": "*",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "zod": "4.6.5"
  }
}
