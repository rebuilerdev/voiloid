{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Worker の WebSocket（Worker Gateway）
	handle /worker {
		reverse_proxy gateway:4100
	}

	# Control API
	handle /api/* {
		reverse_proxy api:4000
	}

	# 内部向けのパスは外部に公開しない
	handle /internal/* {
		respond 404
	}

	# Web GUI（ページを開いたとき）。
	# 古いログイン情報などで 403 が返ったら、エラー画面で止めずに、
	# Cookie を消してログイン画面へ戻す（/api/auth/session-expired が Cookie を消して /login へ転送する）。
	# /login 自体の 403 は、転送を繰り返さないよう、そのまま返す
	@page {
		method GET
		not path /login /login/*
		expression `header({'Sec-Fetch-Dest': 'document'}) || header({'Accept': '*text/html*'})`
	}
	handle @page {
		reverse_proxy web:3000 {
			@forbidden status 403
			handle_response @forbidden {
				header Location /api/auth/session-expired?next={http.request.uri.path}
				respond 302
			}
		}
	}

	# Web GUI（ページ以外: JavaScript・画像・データの取得など）
	handle {
		reverse_proxy web:3000
	}
}
